{
  "name": "vocab-quiz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server.cjs\"",
    "dev:host": "concurrently \"vite --host\" \"node server.cjs\"",
    "dev:test": "DATA_DIR=./test-data concurrently \"vite\" \"node server.cjs\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node server.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^4.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0"
  }
}
